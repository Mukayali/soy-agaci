@model PhotoGalleryViewModel
@{
    ViewData["Title"] = "Fotoğraflar";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2>Fotoğraflar <span class="text-muted fs-6">(@Model.TotalPhotoCount fotoğraf)</span></h2>
    <form method="get" class="d-flex align-items-center gap-2">
        <input type="hidden" name="page" value="1" />
        <label for="pageSizeSelect" class="col-form-label col-form-label-sm text-muted mb-0">Sayfa başına:</label>
        <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
            <option value="12" selected="@(Model.PageSize == 12)">12</option>
            <option value="24" selected="@(Model.PageSize == 24)">24</option>
            <option value="48" selected="@(Model.PageSize == 48)">48</option>
            <option value="96" selected="@(Model.PageSize == 96)">96</option>
        </select>
    </form>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("Editor"))
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Fotoğraf Yükle</h5>
            <p class="text-muted">
                Kişi seçmeden doğrudan fotoğraf yükleyebilirsiniz; yüklenen fotoğraflar
                "İlişkilendirilmemiş Fotoğraflar" altında görünür ve daha sonra bir kişiye
                atanabilir.
            </p>
            <form asp-action="Upload" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                <input type="hidden" name="page" value="@Model.Page" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <input type="file" name="photos" class="form-control" multiple accept=".jpg,.jpeg,.png,.webp" required />
                <button type="submit" class="btn btn-primary text-nowrap">Yükle</button>
            </form>
        </div>
    </div>
}

@if (!Model.Groups.Any() && !Model.UnassignedPhotos.Any())
{
    <p class="text-muted">Henüz hiç fotoğraf yüklenmemiş.</p>
}

@foreach (var group in Model.Groups)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">
                @if (group.PersonIsDeleted)
                {
                    <span class="text-muted">@group.PersonName</span>
                    <span class="badge bg-secondary">Silinmiş Kişi</span>
                }
                else
                {
                    <a asp-controller="Person" asp-action="Details" asp-route-id="@group.PersonId">@group.PersonName</a>
                }
                <span class="text-muted fs-6">(@group.Photos.Count)</span>
            </h5>
            <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3">
                @foreach (var photo in group.Photos)
                {
                    <div class="col">
                        <div class="card h-100">
                            <img src="@photo.FilePath" class="card-img-top photo-thumb" style="height:140px;object-fit:cover;cursor:zoom-in;" alt="@group.PersonName fotoğrafı" data-photo-id="@photo.Id" data-full-src="@photo.FilePath" data-caption="@group.PersonName" />
                            <div class="card-body p-2 text-center">
                                @if (photo.IsPrimary)
                                {
                                    <span class="badge bg-success">Ana Fotoğraf</span>
                                }
                                else if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                                {
                                    <form asp-action="SetPrimary" method="post">
                                        <input type="hidden" name="photoId" value="@photo.Id" />
                                        <input type="hidden" name="personId" value="@group.PersonId" />
                                        <input type="hidden" name="page" value="@Model.Page" />
                                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                        <button type="submit" class="btn btn-sm btn-outline-success w-100">Ana Yap</button>
                                    </form>
                                }
                                @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                                {
                                    <div class="d-flex gap-1 mt-1">
                                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill photo-edit-btn" data-photo-id="@photo.Id" data-photo-src="@photo.FilePath">Düzenle</button>
                                        <form asp-action="Delete" method="post" class="flex-fill" onsubmit="return confirm('Bu fotoğrafı silmek istediğinizden emin misiniz?');">
                                            <input type="hidden" name="photoId" value="@photo.Id" />
                                            <input type="hidden" name="page" value="@Model.Page" />
                                            <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">Sil</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (Model.UnassignedPhotos.Any())
{
    <div class="card mb-4 border-warning">
        <div class="card-body">
            <h5 class="card-title">İlişkilendirilmemiş Fotoğraflar <span class="text-muted fs-6">(@Model.UnassignedPhotos.Count)</span></h5>
            <p class="text-muted">Bu fotoğraflar henüz bir kişiye atanmamış.</p>
            <div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-3">
                @foreach (var photo in Model.UnassignedPhotos)
                {
                    <div class="col">
                        <div class="card h-100">
                            <img src="@photo.FilePath" class="card-img-top photo-thumb" style="height:140px;object-fit:cover;cursor:zoom-in;" alt="İlişkilendirilmemiş fotoğraf" data-photo-id="@photo.Id" data-full-src="@photo.FilePath" data-caption="İlişkilendirilmemiş fotoğraf" />
                            <div class="card-body p-2">
                                @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                                {
                                    <form asp-action="Assign" method="post" class="position-relative mb-2">
                                        <input type="hidden" name="photoId" value="@photo.Id" />
                                        <input type="hidden" name="page" value="@Model.Page" />
                                        <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                        <input type="text" id="personSearch-@photo.Id" class="form-control form-control-sm mb-1" placeholder="Kişi ara..." autocomplete="off" />
                                        <input type="hidden" name="personId" id="personId-@photo.Id" />
                                        <div id="personResults-@photo.Id" class="list-group position-absolute w-100" style="z-index:1000;"></div>
                                        <button type="submit" class="btn btn-sm btn-outline-primary w-100">Kişiye Ata</button>
                                    </form>
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-secondary flex-fill photo-edit-btn" data-photo-id="@photo.Id" data-photo-src="@photo.FilePath">Düzenle</button>
                                        <form asp-action="Delete" method="post" class="flex-fill" onsubmit="return confirm('Bu fotoğrafı silmek istediğinizden emin misiniz?');">
                                            <input type="hidden" name="photoId" value="@photo.Id" />
                                            <input type="hidden" name="page" value="@Model.Page" />
                                            <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">Sil</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (Model.TotalPages > 1)
{
    // Person/Index'teki aynı pencere + ilk/son sayfa + "..." deseni.
    const int window = 2;
    var pageNumbers = new List<int?> { 1 };
    for (var i = Model.Page - window; i <= Model.Page + window; i++)
    {
        if (i > 1 && i < Model.TotalPages)
        {
            pageNumbers.Add(i);
        }
    }
    if (Model.TotalPages > 1)
    {
        pageNumbers.Add(Model.TotalPages);
    }

    var pages = new List<int?>();
    int? previous = null;
    foreach (var p in pageNumbers)
    {
        if (previous.HasValue && p.HasValue && p.Value - previous.Value > 1)
        {
            pages.Add(null);
        }
        pages.Add(p);
        previous = p;
    }

    <nav>
        <ul class="pagination flex-wrap">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageSize="@Model.PageSize" asp-route-page="@(Model.Page - 1)">‹ Önceki</a>
            </li>
            @foreach (var p in pages)
            {
                if (p == null)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                else
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pageSize="@Model.PageSize" asp-route-page="@p">@p</a>
                    </li>
                }
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-pageSize="@Model.PageSize" asp-route-page="@(Model.Page + 1)">Sonraki ›</a>
            </li>
        </ul>
    </nav>
}

<div class="modal fade" id="photoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-dark">
            <div class="modal-header border-0 py-2">
                <h6 class="modal-title text-white" id="photoModalCaption"></h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body text-center p-0 pb-3">
                <img id="photoModalImg" src="" class="img-fluid" style="max-height:80vh;" alt="Büyütülmüş fotoğraf" />
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("Editor"))
{
    <div class="modal fade" id="editPhotoModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Fotoğrafı Düzenle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body text-center">
                    <div class="btn-toolbar justify-content-center gap-2 mb-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="editRotateLeft">↺ Sola Döndür</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="editRotateRight">↻ Sağa Döndür</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="editApplyCrop">Kırp</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="editUndo" disabled>↶ Geri Al</button>
                        <button type="button" class="btn btn-sm btn-outline-warning" id="editReset">Sıfırla</button>
                    </div>
                    <p class="text-muted small mb-2">Kırpmak için fotoğraf üzerinde bir alanı sürükleyerek seçin, sonra "Kırp" butonuna basın.</p>
                    <div class="d-flex justify-content-center bg-dark-subtle rounded p-2">
                        <canvas id="editCanvas" style="max-width:100%;max-height:60vh;touch-action:none;cursor:crosshair;"></canvas>
                    </div>
                </div>
                <div class="modal-footer">
                    <span id="editErrorMsg" class="text-danger small me-auto"></span>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="button" class="btn btn-primary" id="editSaveBtn">Kaydet</button>
                </div>
            </div>
        </div>
    </div>
}

