@model PersonIndexViewModel
@{
    ViewData["Title"] = "Kişiler";
}

@if (Model.SulaleAdi != null)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center">
        <span><strong>@Model.SulaleAdi</strong> sülalesi üyeleri gösteriliyor.</span>
        <a asp-action="Index" asp-route-q="@Model.Query" class="btn btn-sm btn-outline-secondary">Filtreyi Temizle</a>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Kişiler <span class="text-muted fs-6">(@Model.TotalCount kayıt)</span></h2>
    <div>
        <a asp-action="ExportCsv" asp-route-q="@Model.Query" class="btn btn-outline-secondary">CSV Dışa Aktar</a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Deleted" class="btn btn-outline-secondary">Silinmiş Kişiler</a>
        }
        @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
        {
            <button type="button" class="btn btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#csvImportPanel">CSV İçe Aktar</button>
            <a asp-action="Create" class="btn btn-primary">+ Yeni Kişi</a>
        }
    </div>
</div>

@if (TempData["ImportWarnings"] is string importWarnings)
{
    <div class="alert alert-warning">
        <strong>Uyarılar:</strong>
        <pre class="mb-0" style="white-space:pre-wrap;">@importWarnings</pre>
    </div>
}

@if (User.IsInRole("Admin") || User.IsInRole("Editor"))
{
    <div class="collapse mb-3" id="csvImportPanel">
        <div class="card card-body">
            <h5 class="card-title">CSV ile Toplu Kişi Yükleme</h5>
            <p class="text-muted">
                Sütunlar: <code>TCKimlikNo, Ad, Soyad, Cinsiyet, DogumTarihi, OlumTarihi, AnneTC, BabaTC, DogumYeri, SulaleId</code>.
                <code>Ad</code> ve <code>Soyad</code> zorunludur, diğerleri opsiyoneldir.
                <strong><code>TCKimlikNo</code> zaten sistemde kayıtlı bir kişiye aitse yeni kişi
                oluşturulmaz, o kişi satırdaki bilgilerle güncellenir</strong> (upsert) — satırda
                boş bırakılan alanlar kişinin mevcut değerini korur, üzerine yazılmaz.
                <code>AnneTC</code>/<code>BabaTC</code>, dosyadaki başka bir satırın veya sistemde zaten
                kayıtlı bir kişinin TC Kimlik No'suna eşleşerek anne/baba ilişkisini otomatik kurar
                (bu, güncellenen satırlar için de geçerlidir).
                Cinsiyet için <code>Erkek</code>/<code>Kadın</code> (veya E/K) kullanın; tarihler
                <code>yyyy-aa-gg</code> (ör. 1990-05-05) veya <code>gg.aa.yyyy</code> formatında olabilir.
                <code>DogumYeri</code> serbest metindir. <code>SulaleId</code>, kişiyi mevcut bir veya
                birden fazla sülaleye bağlamak için o sülale(ler)in numarasıdır — birden fazla sülale
                için <code>;</code> ile ayırın (ör. <code>2;5</code>); numaralar
                (<a asp-controller="Sulale" asp-action="Index">Sülaleler</a> sayfasındaki Id
                sütunundan bulunabilir) eşleşmezse o sülale ataması yapılmadan devam edilir.
            </p>
            <p>
                <a asp-action="CsvImportTemplate" class="btn btn-sm btn-outline-primary">Örnek Şablon İndir</a>
            </p>
            <form asp-action="ImportCsv" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                <input type="file" name="csvFile" class="form-control" accept=".csv" required />
                <button type="submit" class="btn btn-primary text-nowrap">İçe Aktar</button>
            </form>
        </div>
    </div>
}

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="sulaleId" value="@Model.SulaleId" />
    <div class="col-auto">
        <input type="text" name="q" value="@Model.Query" class="form-control" placeholder="Ad, soyad veya TC Kimlik No" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
    </div>
</form>

@if (!Model.Persons.Any())
{
    <p class="text-muted">Kayıt bulunamadı.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Ad Soyad</th>
                @if (User.IsInRole("Admin"))
                {
                    <th>TC Kimlik No</th>
                }
                <th>Doğum</th>
                <th>Ölüm</th>
                <th>Anne</th>
                <th>Baba</th>
                <th>Sülale</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Persons)
            {
                <tr>
                    <td>@p.AdSoyad</td>
                    @if (User.IsInRole("Admin"))
                    {
                        <td>@(p.TcKimlikNo ?? "-")</td>
                    }
                    <td>@(p.DogumTarihi?.ToString("dd.MM.yyyy") ?? "-")</td>
                    <td>@(p.OlumTarihi?.ToString("dd.MM.yyyy") ?? "-")</td>
                    <td>@(p.AnneAdSoyad ?? "-")</td>
                    <td>@(p.BabaAdSoyad ?? "-")</td>
                    <td>
                        @if (p.Sulaleler.Any())
                        {
                            @for (var i = 0; i < p.Sulaleler.Count; i++)
                            {
                                <a asp-action="Index" asp-route-sulaleId="@p.Sulaleler[i].Id">@p.Sulaleler[i].Ad</a>
                                if (i < p.Sulaleler.Count - 1)
                                {
                                    @:,
                                }
                            }
                        }
                        else
                        {
                            @:-
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Detay</a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                        {
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                        }
                        <a asp-controller="FamilyTree" asp-action="Index" asp-route-id="@p.Id" class="btn btn-sm btn-outline-success">Soy Ağacını Gör</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        // Sayfa sayısı büyük ailelerde çok yüksek olabildiğinden (ör. 30+ sayfa) tüm sayfa
        // numaralarını basmak yerine mevcut sayfanın etrafında bir pencere + ilk/son sayfa +
        // "..." gösterilir; Önceki/Sonraki de eklenmiştir.
        const int window = 2;
        var pageNumbers = new List<int?> { 1 };
        for (var i = Model.Page - window; i <= Model.Page + window; i++)
        {
            if (i > 1 && i < Model.TotalPages)
            {
                pageNumbers.Add(i);
            }
        }
        if (Model.TotalPages > 1)
        {
            pageNumbers.Add(Model.TotalPages);
        }

        var pages = new List<int?>();
        int? previous = null;
        foreach (var p in pageNumbers)
        {
            if (previous.HasValue && p.HasValue && p.Value - previous.Value > 1)
            {
                pages.Add(null);
            }
            pages.Add(p);
            previous = p;
        }

        <nav>
            <ul class="pagination flex-wrap">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-q="@Model.Query" asp-route-sulaleId="@Model.SulaleId" asp-route-page="@(Model.Page - 1)">‹ Önceki</a>
                </li>
                @foreach (var p in pages)
                {
                    if (p == null)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    else
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-q="@Model.Query" asp-route-sulaleId="@Model.SulaleId" asp-route-page="@p">@p</a>
                        </li>
                    }
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-q="@Model.Query" asp-route-sulaleId="@Model.SulaleId" asp-route-page="@(Model.Page + 1)">Sonraki ›</a>
                </li>
            </ul>
        </nav>
    }
}
