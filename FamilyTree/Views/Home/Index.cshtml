@model HomeViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h2 class="display-6">@Model.ToplamKisi</h2>
                <p class="text-muted mb-0">Toplam Kişi</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow-sm position-relative">
            <div class="card-body">
                <h2 class="display-6">@Model.ToplamFotograf</h2>
                <a asp-controller="Photos" asp-action="Index" class="stretched-link text-decoration-none text-muted mb-0">Toplam Fotoğraf</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
                {
                    <a asp-controller="Person" asp-action="Create" class="btn btn-primary btn-lg mt-2">+ Yeni Kişi Ekle</a>
                }
                else
                {
                    <a asp-controller="Person" asp-action="Index" class="btn btn-outline-primary btn-lg mt-2">Kişileri Görüntüle</a>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.BugunDoganlar.Any())
{
    <h4 class="mb-3">🎂 Bugün Doğanlar</h4>
    <div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
        @foreach (var person in Model.BugunDoganlar)
        {
            <div class="col">
                <a asp-controller="Person" asp-action="Details" asp-route-id="@person.Id" class="text-decoration-none text-reset">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex align-items-center gap-3">
                            @if (person.PrimaryPhotoPath != null)
                            {
                                <img src="@person.PrimaryPhotoPath" class="rounded-circle" style="width:56px;height:56px;object-fit:cover;flex-shrink:0;" alt="@person.AdSoyad" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center text-muted flex-shrink-0" style="width:56px;height:56px;">?</div>
                            }
                            <div>
                                <h6 class="card-title mb-1">@person.AdSoyad</h6>
                                <p class="card-text text-muted mb-0 small">@person.DogumYili — @person.Yas yaşında</p>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

@if (Model.BugunKaybettiklerimiz.Any())
{
    <h4 class="mb-3">🕯️ Bugün Kaybettiklerimiz</h4>
    <div class="row row-cols-1 row-cols-md-3 g-3 mb-4">
        @foreach (var person in Model.BugunKaybettiklerimiz)
        {
            <div class="col">
                <a asp-controller="Person" asp-action="Details" asp-route-id="@person.Id" class="text-decoration-none text-reset">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex align-items-center gap-3">
                            @if (person.PrimaryPhotoPath != null)
                            {
                                <img src="@person.PrimaryPhotoPath" class="rounded-circle" style="width:56px;height:56px;object-fit:cover;flex-shrink:0;" alt="@person.AdSoyad" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center text-muted flex-shrink-0" style="width:56px;height:56px;">?</div>
                            }
                            <div>
                                <h6 class="card-title mb-1">@person.AdSoyad</h6>
                                <p class="card-text text-muted mb-0 small">
                                    @(person.DogumYili?.ToString() ?? "?")@(person.Yas.HasValue ? $" — {person.Yas} yaşında" : "")
                                </p>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

<h4 class="mb-3">Son Eklenen Kişiler</h4>

@if (!Model.SonEklenenler.Any())
{
    <p class="text-muted">
        Henüz kişi eklenmemiş.
        @if (User.IsInRole("Admin") || User.IsInRole("Editor"))
        {
            <a asp-controller="Person" asp-action="Create">İlk kişiyi ekleyin.</a>
        }
    </p>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-3">
        @foreach (var person in Model.SonEklenenler)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">@person.AdSoyad</h5>
                        <p class="card-text text-muted">
                            @(person.DogumTarihi?.ToString("yyyy") ?? "?") - @(person.OlumTarihi?.ToString("yyyy") ?? "")
                        </p>
                        <a asp-controller="Person" asp-action="Details" asp-route-id="@person.Id" class="btn btn-sm btn-outline-primary">Detay</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
