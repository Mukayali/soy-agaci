@model List<UserListItemViewModel>
@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Kullanıcılar</h2>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Kullanıcı</a>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>E-posta</th>
            <th>Rol</th>
            <th>Durum</th>
            <th>Oluşturulma</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Email</td>
                <td>@string.Join(", ", u.Roller)</td>
                <td>
                    @if (u.KilitliMi)
                    {
                        <span class="badge bg-danger">Kilitli</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                </td>
                <td>@u.CreatedAt.ToString("dd.MM.yyyy")</td>
                <td class="text-end">
                    <a asp-action="EditRole" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">Rolü Değiştir</a>
                    <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Bu kullanıcıyı silmek istediğinizden emin misiniz?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
