@model UserEditRoleViewModel
@{
    ViewData["Title"] = "Kullanıcı Rolünü Değiştir";
    var roles = (string[])ViewBag.Roles;
}

<h2>Kullanıcı Rolünü Değiştir</h2>
<p class="text-muted">@Model.Email</p>

<form asp-action="EditRole" asp-route-id="@Model.Id" method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Email" />

    <div class="mb-3">
        <label asp-for="Rol" class="form-label"></label>
        <select asp-for="Rol" class="form-select">
            @foreach (var role in roles)
            {
                <option value="@role">@role</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
</form>
